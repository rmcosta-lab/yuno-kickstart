# Application
APP_ENV=development
# Server-only upstream used by the Next.js demo proxy.
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Shared only between Next.js and FastAPI. Never expose it with NEXT_PUBLIC_.
VOLTA_DEMO_BEARER_TOKEN=
VOLTA_EXTRACTION_MODE=deterministic
VOLTA_EXTRACTION_POLICY_VERSION=intake-v1
VOLTA_REALTIME_VOICE=marin
VOLTA_REALTIME_SUBJECT=demo-coordinator
VOLTA_MUTATION_RATE_LIMIT_REQUESTS=30
VOLTA_MUTATION_RATE_LIMIT_WINDOW_SECONDS=60
VOLTA_MUTATION_RATE_LIMIT_MAX_IDENTITIES=256
# Local default uses the operating-system temporary directory. Set this to the
# Render persistent-disk mount for the hosted hackathon demo.
VOLTA_EVIDENCE_STORAGE_PATH=

# Local PostgreSQL
POSTGRES_DB=yuno
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/yuno

# Yuno server-side sandbox
YUNO_BASE_URL=https://api-sandbox.y.uno
YUNO_ACCOUNT_CODE=
YUNO_ACCOUNT_ID=
YUNO_PUBLIC_API_KEY=
YUNO_PRIVATE_SECRET_KEY=
YUNO_COUNTRY_CODE=BR
YUNO_CURRENCY=BRL

# Yuno browser SDK
# This public key may reach the browser. Never use NEXT_PUBLIC_ for a private key.
NEXT_PUBLIC_YUNO_PUBLIC_API_KEY=

# Yuno webhook verification
YUNO_WEBHOOK_HMAC_SECRET=

# Optional AI integration
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EXTRACTION_MODEL=gpt-5.6-luna
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_SAFETY_IDENTIFIER_KEY=

# Twilio server-side telephony (one explicitly authorized demo destination)
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_E164=
TWILIO_DESTINATION_ALLOWLIST={}
# Opaque synthetic label to explicitly authorized inbound caller mapping.
TWILIO_INBOUND_CALLER_ALLOWLIST={}
TWILIO_INBOUND_DESTINATION_E164=
TWILIO_PUBLIC_BASE_URL=https://telephony.example.com
TWILIO_MEDIA_WS_URL=wss://telephony.example.com/v1/telephony/twilio/media

# Fase 07 injected test boundary for /intake and /mandate (no live backend
# until Fase 10). Set to "false" once the real API is wired.
NEXT_PUBLIC_INTAKE_USE_TEST_BOUNDARY=true
