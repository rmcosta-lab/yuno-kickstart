# Application
APP_ENV=development
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
VOLTA_DEMO_BEARER_TOKEN=
VOLTA_EXTRACTION_POLICY_VERSION=intake-v1
VOLTA_MUTATION_RATE_LIMIT_REQUESTS=30
VOLTA_MUTATION_RATE_LIMIT_WINDOW_SECONDS=60
VOLTA_MUTATION_RATE_LIMIT_MAX_IDENTITIES=256

# Local PostgreSQL
POSTGRES_DB=yuno
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/yuno

# Yuno server-side sandbox
YUNO_BASE_URL=https://api-sandbox.y.uno
YUNO_ACCOUNT_CODE=
YUNO_ACCOUNT_ID=
YUNO_PUBLIC_API_KEY=
YUNO_PRIVATE_SECRET_KEY=
YUNO_COUNTRY_CODE=BR
YUNO_CURRENCY=BRL

# Yuno browser SDK
# This public key may reach the browser. Never use NEXT_PUBLIC_ for a private key.
NEXT_PUBLIC_YUNO_PUBLIC_API_KEY=

# Yuno webhook verification
YUNO_WEBHOOK_HMAC_SECRET=

# Optional AI integration
OPENAI_API_KEY=

# Fase 07 injected test boundary for /intake and /mandate (no live backend
# until Fase 10). Set to "false" once the real API is wired.
NEXT_PUBLIC_INTAKE_USE_TEST_BOUNDARY=true
